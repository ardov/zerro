{
  "name": "zerro",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "pnpm typecheck && pnpm build:app",
    "build:app": "vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "preview": "vite preview --port 3000",
    "tsc": "tsc --watch",
    "test": "vitest run --reporter=agent --silent=passed-only",
    "test:watch": "vitest",
    "test:changed": "pnpm test --changed --passWithNoTests",
    "test:related": "vitest related --run --reporter=agent --silent=passed-only",
    "lint:css": "stylelint \"src/**/*.css\" --max-warnings 0",
    "lint": "pnpm lint:css && pnpm lint:js",
    "lint:js": "eslint src tools stories .storybook --max-warnings 0 --cache",
    "knip": "knip --dependencies",
    "knip:exports": "knip --exports --no-exit-code",
    "format": "node tools/format-tracked.mjs --write",
    "format:check": "node tools/format-tracked.mjs --check",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "test:storybook": "vitest --config vitest.storybook.config.ts run --reporter=agent --silent=passed-only",
    "test:storybook:watch": "vitest --config vitest.storybook.config.ts",
    "verify:whitespace": "git diff --check \"${VERIFY_BASE_SHA:-HEAD}\"",
    "verify": "pnpm verify:whitespace && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "verify:ui": "pnpm build:app && pnpm build-storybook && pnpm test:storybook",
    "verify:all": "pnpm verify && pnpm verify:ui && pnpm knip"
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true,
    "arrowParens": "avoid"
  },
  "stylelint": {
    "defaultSeverity": "warning",
    "extends": [
      "stylelint-config-recommended"
    ],
    "rules": {
      "no-descending-specificity": null,
      "no-duplicate-selectors": null,
      "at-rule-no-unknown": [
        true,
        {
          "ignoreAtRules": [
            "custom-variant",
            "source",
            "theme",
            "utility"
          ]
        }
      ]
    }
  },
  "browserslist": [
    "defaults"
  ],
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@reduxjs/toolkit": "^2.13.0",
    "@sentry/browser": "^11.8.0",
    "@tanstack/react-virtual": "^3.14.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "date-fns": "^4.4.0",
    "formik": "^2.4.9",
    "i18next": "^26.4.7",
    "idb": "^8.0.4",
    "immer": "^11.1.21",
    "lucide-react": "^1.59.0",
    "matter-js": "^0.20.0",
    "motion": "^14.3.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hotkeys-hook": "^5.3.3",
    "react-i18next": "^17.0.21",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tldts": "^7.4.18",
    "uuid": "^14.0.3",
    "workbox-window": "^7.4.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mdx-js/rollup": "^3.1.1",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/culori": "^4.0.1",
    "@types/matter-js": "^0.20.2",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "10.6.2",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.3",
    "knip": "^6.41.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.10",
    "storybook": "10.6.2",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended": "18.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c"
}
