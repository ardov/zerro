{
  "name": "zerro",
  "version": "1.9.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "pnpm typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "preview": "vite preview --port 3000",
    "tsc": "tsc --watch",
    "test": "vitest",
    "zerro-core:package-check": "node scripts/check-zerro-core-package.mjs",
    "lint:css": "stylelint \"src/**/*.{css,scss}\" --max-warnings 0",
    "lint": "pnpm typecheck",
    "lint:js": "eslint src --max-warnings 0",
    "knip": "knip --dependencies",
    "knip:exports": "knip --exports --no-exit-code",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,scss,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,css,scss,json,md}\""
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true,
    "arrowParens": "avoid"
  },
  "stylelint": {
    "defaultSeverity": "warning",
    "extends": [
      "stylelint-config-recommended-scss"
    ]
  },
  "browserslist": [
    "defaults"
  ],
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@mui/system": "^9.2.0",
    "@mui/x-date-pickers": "^9.10.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@sentry/browser": "^10.65.0",
    "date-fns": "^4.4.0",
    "formik": "^2.4.9",
    "i18next": "^26.3.6",
    "idb": "^8.0.3",
    "json2mq": "^0.2.0",
    "lodash": "^4.18.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-helmet-async": "3.0.0",
    "react-hotkeys-hook": "^5.3.3",
    "react-i18next": "^17.0.10",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.1",
    "react-scan": "^0.5.7",
    "react-transition-group": "^4.4.5",
    "react-virtualized-auto-sizer": "^2.0.3",
    "react-window": "^2.2.7",
    "react-wrap-balancer": "^1.1.1",
    "recharts": "^3.9.2",
    "use-local-storage-state": "^20.0.0",
    "uuid": "^14.0.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mdx-js/rollup": "^3.1.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/json2mq": "^0.2.2",
    "@types/lodash": "^4.17.24",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-transition-group": "^4.4.12",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "happy-dom": "^20.10.6",
    "knip": "^6.27.0",
    "prettier": "^3.9.5",
    "sass": "^1.101.0",
    "stylelint": "^17.14.0",
    "stylelint-config-recommended-scss": "17.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.33.2"
}
