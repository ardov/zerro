{
  "name": "zerro",
  "version": "1.9.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "pnpm typecheck && pnpm build:app",
    "build:app": "vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p tools/zerro/tsconfig.json",
    "preview": "vite preview --port 3000",
    "tsc": "tsc --watch",
    "test": "vitest run --reporter=agent --silent=passed-only",
    "test:watch": "vitest",
    "test:changed": "pnpm test --changed --passWithNoTests",
    "test:related": "vitest related --run --reporter=agent --silent=passed-only",
    "lint:css": "stylelint \"src/**/*.{css,scss}\" --max-warnings 0",
    "lint": "pnpm lint:css && pnpm lint:js",
    "lint:js": "eslint src tools stories .storybook --max-warnings 0 --cache",
    "zerro": "tsx tools/zerro/src/cli.ts",
    "knip": "knip --dependencies",
    "knip:exports": "knip --exports --no-exit-code",
    "format": "node tools/format-tracked.mjs --write",
    "format:check": "node tools/format-tracked.mjs --check",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "test:storybook": "vitest --config vitest.storybook.config.ts run --reporter=agent --silent=passed-only",
    "test:storybook:watch": "vitest --config vitest.storybook.config.ts",
    "verify:whitespace": "git diff --check \"${VERIFY_BASE_SHA:-HEAD}\"",
    "verify": "pnpm verify:whitespace && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "verify:ui": "pnpm build:app && pnpm build-storybook && pnpm test:storybook",
    "verify:all": "pnpm verify && pnpm verify:ui && pnpm knip"
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true,
    "arrowParens": "avoid"
  },
  "stylelint": {
    "defaultSeverity": "warning",
    "extends": [
      "stylelint-config-recommended-scss"
    ],
    "rules": {
      "scss/at-rule-no-unknown": [
        true,
        {
          "ignoreAtRules": [
            "custom-variant",
            "source",
            "theme",
            "utility"
          ]
        }
      ]
    }
  },
  "browserslist": [
    "defaults"
  ],
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/core": "^6.3.1",
    "@reduxjs/toolkit": "^2.12.0",
    "@sentry/browser": "^10.65.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "formik": "^2.4.9",
    "i18next": "^26.3.6",
    "idb": "^8.0.3",
    "json2mq": "^0.2.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-hotkeys-hook": "^5.3.3",
    "react-i18next": "^17.0.10",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.1",
    "react-virtualized-auto-sizer": "^2.0.3",
    "react-window": "^2.2.7",
    "react-wrap-balancer": "^1.1.1",
    "recharts": "^3.9.2",
    "tailwind-merge": "^3.6.0",
    "use-local-storage-state": "^20.0.0",
    "uuid": "^14.0.1",
    "workbox-window": "^7.4.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mdx-js/rollup": "^3.1.1",
    "@storybook/addon-a11y": "10.5.5",
    "@storybook/addon-docs": "10.5.5",
    "@storybook/addon-vitest": "10.5.5",
    "@storybook/react-vite": "10.5.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/json2mq": "^0.2.2",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "10.5.5",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.7.0",
    "happy-dom": "^20.10.6",
    "knip": "^6.27.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.5",
    "sass": "^1.101.0",
    "storybook": "10.5.5",
    "stylelint": "^17.14.0",
    "stylelint-config-recommended-scss": "17.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.33.2"
}
