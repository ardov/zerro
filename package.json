{
  "name": "zerro",
  "version": "1.9.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "tsc && vite build",
    "preview": "vite preview --port 3000",
    "tsc": "tsc --watch",
    "test": "vitest",
    "zerro-core:package-check": "node scripts/check-zerro-core-package.mjs",
    "lint:css": "stylelint \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint": "npx tsc --noEmit",
    "lint:js": "eslint src --max-warnings 0",
    "knip": "knip",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,scss,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,css,scss,json,md}\""
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true,
    "arrowParens": "avoid"
  },
  "stylelint": {
    "defaultSeverity": "warning",
    "extends": [
      "stylelint-config-recommended"
    ]
  },
  "browserslist": [
    "defaults"
  ],
  "pnpm": {
    "overrides": {
      "@types/react": "18.3.18"
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.10",
    "@mui/material": "^7.3.10",
    "@mui/system": "^7.3.10",
    "@mui/x-date-pickers": "^8.28.4",
    "@reduxjs/toolkit": "^2.11.2",
    "@sentry/browser": "^10.50.0",
    "comlink": "^4.4.2",
    "convert-layout": "^0.11.1",
    "date-fns": "^4.1.0",
    "formik": "^2.4.9",
    "history": "^4.10.1",
    "i18next": "^25.10.10",
    "idb": "^8.0.2",
    "json2mq": "^0.2.0",
    "lodash": "^4.18.1",
    "prop-types": "^15.8.1",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-hotkeys-hook": "^5.2.4",
    "react-i18next": "^16.6.6",
    "react-redux": "^9.2.0",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4",
    "react-scan": "^0.4.3",
    "react-transition-group": "^4.4.5",
    "react-virtualized-auto-sizer": "^1.0.24",
    "react-window": "^1.8.10",
    "react-wrap-balancer": "^1.1.1",
    "recharts": "^3.8.1",
    "use-local-storage-state": "^19.5.0",
    "uuid": "^13.0.0",
    "workbox-build": "^7.4.0",
    "workbox-window": "^7.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@mdx-js/rollup": "^3.1.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/convert-layout": "^0.5.3",
    "@types/history": "^4.7.11",
    "@types/json2mq": "^0.2.2",
    "@types/lodash": "^4.17.24",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@types/react-helmet": "^6.1.11",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "@types/react-transition-group": "^4.4.12",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "happy-dom": "^20.9.0",
    "knip": "^5.66.5",
    "prettier": "^3.8.3",
    "sass": "^1.99.0",
    "stylelint": "^16.26.1",
    "stylelint-config-recommended": "^17.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vite": "^7.3.5",
    "vite-plugin-pwa": "^1.2.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@10.33.2"
}
